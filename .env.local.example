# Resend settings for the /api/quote form endpoint
# Copy this file to .env.local and fill in your real values (never commit .env.local)
#
# Raw SMTP does not work on Vercel serverless (DNS/outbound SMTP is restricted),
# so quote emails are sent over Resend's HTTPS API instead.

RESEND_API_KEY=re_your_api_key_here

# Must be an address on a domain you have verified in Resend
QUOTE_FROM_EMAIL=quotes@sunwareenergy.com

# Where quote requests get delivered (your normal Zoho inbox)
QUOTE_TO_EMAIL=info@sunwareenergy.com
